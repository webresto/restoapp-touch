<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The servers this app administers. Repeated although superizer:host declares it too: what the
      app may claim about itself in Google Play is written against this file, not the merged one.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Superizer's haptic tick (the drawer, the keys). Normal: granted at install, never asked. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      No push in RestoApp (D3): the permission superizer:host brings for it is taken out, so the app
      never asks for notifications.
    -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:node="remove" />

    <!-- No advertising ID, whatever a Google library would merge in: the Play form says «no». -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!--
      allowBackup="false" and the extraction rules: nothing of this app goes into a backup or to a
      new phone. The device token of each server is a file in it, and restored on another phone it
      would be a second device under the first one's name. A new phone connects its servers again.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RestoApp"
        tools:targetApi="31">

        <!-- superizer:host compiles FCM in; RestoApp has no push (D3), so it never starts. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <!--
          One activity, and the host in it outlives a rotation (MainActivity): the configuration
          changes Compose follows by itself do not recreate it.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode|smallestScreenSize|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
