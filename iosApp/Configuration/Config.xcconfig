// The Apple Developer team that signs the app and owns it in App Store Connect: the personal team
// "Ivan Sizyi" (RELEASING.md, iOS).
TEAM_ID=ZK66E83UL5
DEVELOPMENT_TEAM=$(TEAM_ID)
// The same identifier as the Android application id in Google Play. The package of the code stays
// cx.m42.restoapp (D2); the stores never compare the two.
BUNDLE_ID=org.restoapp.touch
APP_NAME=RestoApp
ASSETCATALOG_COMPILER_APPICON_NAME=AppIcon
// Kotlin builds the simulator framework for Apple silicon only (iosSimulatorArm64, no iosX64), so a
// build for "any simulator" must not ask for an Intel slice the framework does not have.
EXCLUDED_ARCHS[sdk=iphonesimulator*]=x86_64
// Automatic for a person at Xcode. The testflight lane of ios.yml signs by hand with an App Store
// profile, and writes that into Signing.xcconfig for the one run (tools/ios-ci-signing.py). Set
// here rather than in the project, which would outrank this file.
CODE_SIGN_STYLE=Automatic
#include? "Signing.xcconfig"
